#!/bin/sh
# Sets itself up on first run (a private Python environment in .venv), then starts.
set -e
here="$(cd "$(dirname "$0")" && pwd)"
venv="$here/.venv"

if [ ! -x "$venv/bin/python" ] || ! "$venv/bin/python" -c "import cv2, numpy, qrcode" 2>/dev/null; then
  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c "import venv" 2>/dev/null; then
    echo "Python 3 is needed. On a Mac, run:  xcode-select --install"
    echo "then run this again."
    exit 1
  fi
  echo "First run: setting up (downloads ~60 MB, one time only)..."
  rm -rf "$venv"
  python3 -m venv "$venv"
  "$venv/bin/python" -m pip install --quiet --disable-pip-version-check -r "$here/requirements.txt"
  echo "Ready."
  echo
fi

exec "$venv/bin/python" "$here/ga_to_light.py" "$@"
